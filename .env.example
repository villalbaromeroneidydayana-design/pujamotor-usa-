# ============================================================================
# AUTOS USA — PLANTILLA DE VARIABLES DE ENTORNO (SIN SECRETOS REALES)
# Copie este archivo a .env y genere secretos criptográficos únicos por entorno:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# 1. BASE DE DATOS
DATABASE_URL="file:./autos_usa.db"

# 2. SEGURIDAD Y SESIONES ADMINISTRATIVAS (Secretos independientes de mínimo 32 caracteres)
AUTH_SECRET="<generar-secreto-independiente-hmac-64-hex>"
ENCRYPTION_KEY_PII="<generar-llave-independiente-aes256-64-hex>"

# 3. POLÍTICA DE VISIBILIDAD DE DATOS DE DEMOSTRACIÓN
ALLOW_DEMO_DATA_IN_PUBLIC_CATALOG="true"

# 4. INTEGRACIÓN AUTORIZADA CON COPART
COPART_INTEGRATION_MODE="CSV_MEMBER_EXPORT"
COPART_B2B_API_BASE_URL=""
COPART_B2B_CLIENT_ID=""
COPART_B2B_CLIENT_SECRET=""
COPART_B2B_MEMBER_NUMBER=""

# 5. API OFICIAL NHTSA vPIC
NHTSA_VPIC_API_URL="https://vpic.nhtsa.dot.gov/api/vehicles"

# 6. ALMACENAMIENTO DE FOTOGRAFÍAS AUTORIZADAS Y DOCUMENTOS
STORAGE_DRIVER="LOCAL"
S3_BUCKET_NAME=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT_URL=""
